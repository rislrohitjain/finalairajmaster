# ==============================================================================
# RAJASTHAN ADMINISTRATIVE & GEOGRAPHIC MASTER (finalairajmaster)
# DUAL-ENVIRONMENT CONFIGURATION: LOCAL & HUGGING FACE SPACES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT MODE ('local' or 'huggingface')
# Note: On Hugging Face Spaces, SPACE_ID is automatically injected by the platform.
# ------------------------------------------------------------------------------
ENV_MODE=local

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# OPTION A: Local PostgreSQL
DATABASE_URL=postgresql://postgres:Admin@123@127.0.0.1:5432/finalairajmaster

# OPTION B: Cloud Aiven PostgreSQL (Used for Hugging Face Spaces)
# DATABASE_URL=postgres://avnadmin:your_aiven_password_here@pg-220ae514-rislrohitjain-94e5.e.aivencloud.com:18902/defaultdb?sslmode=require

# Individual DB fields (used if DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Admin@123
DB_NAME=finalairajmaster
ENABLE_POSTGRES=true

# ------------------------------------------------------------------------------
# 3. LOCAL OLLAMA CONFIGURATION (When ENV_MODE=local)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
DEFAULT_OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# 4. HUGGING FACE SPACES CONFIGURATION (When ENV_MODE=huggingface or SPACE_ID set)
# ------------------------------------------------------------------------------
# Get your User Access Token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_access_token_here

# ------------------------------------------------------------------------------
# 5. APPLICATION & HELPLINE SETTINGS
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=finalairajmaster_super_secret_key_2026
SUPPORT_PHONE=89988555525
RAJMASTER_BASE_URL=https://rajmasters.rajasthan.gov.in
